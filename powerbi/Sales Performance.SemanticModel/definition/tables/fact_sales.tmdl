table fact_sales
	lineageTag: c2a7eb54-ca9d-460f-a86c-2d5cb9087e8d

	measure 'Sales Amount' = SUM(fact_sales[sales_amount])
		formatString: #,0.00
		lineageTag: 7a43eefb-cde9-4643-8eb1-2edee176929a

		changedProperty = IsHidden

	measure Orders = DISTINCTCOUNT(fact_sales[order_number])
		formatString: 0
		lineageTag: a05b2039-572a-4092-835c-3667ab8b6b86

	measure 'Total Quantity' = SUM(fact_sales[quantity])
		formatString: 0
		lineageTag: b2467b37-6474-432d-ae34-7a9157f1f2f2

	measure 'Average Order Value' = DIVIDE([Sales Amount], [Orders])
		formatString: #,0.00
		lineageTag: d9450ba0-e27a-41c6-bafd-4c8e6abf99d2

	measure 'Sales Without Order Date' =
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS(fact_sales),
			        REMOVEFILTERS('Calendar'),
			        KEEPFILTERS(fact_sales[order_date_key] = 0)
			    ),
			    0
			)
		formatString: 0
		lineageTag: deba4f0b-eb88-44bd-815b-1a2754794ab5

	measure 'Sales Amount Without Order Date' =
			
			COALESCE(
			    CALCULATE(
			        [Sales Amount],
			        REMOVEFILTERS('Calendar'),
			        KEEPFILTERS(fact_sales[order_date_key] = 0)
			    ),
			    0
			)
		formatString: #,0.00
		lineageTag: 7db287b7-f51a-4d04-a02a-ed7d264098c3

